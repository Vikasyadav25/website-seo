{
  "name": "website-seo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint web eslint.config.js playwright.config.ts",
    "format": "prettier --write web agents docs scripts schemas examples *.json *.md .github",
    "format:check": "prettier --check web docs scripts schemas examples *.json *.md .github",
    "test": "vitest run --config web/vite.config.ts",
    "test:e2e": "playwright test",
    "validate:data": "python scripts/validate-public-data.py web/public/data/report.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.9.1"
}
