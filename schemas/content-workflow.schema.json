{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "preparedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "const": "assisted"
    },
    "status": {
      "const": "needs_review"
    },
    "stages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "research",
              "keywords",
              "writing",
              "images",
              "review",
              "publishing"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "status": {
            "enum": ["complete", "needs_review", "blocked"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": ["id", "label", "status", "evidence"]
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 150
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": ["label", "url", "note"]
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "metaTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "metaDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": ["heading", "text"]
          }
        },
        "faqs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": ["question", "answer"]
          }
        }
      },
      "required": [
        "title",
        "metaTitle",
        "metaDescription",
        "slug",
        "sections",
        "faqs"
      ]
    },
    "images": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string",
            "pattern": "^content/[a-z0-9-]+/[a-z0-9-]+[.](jpg|png|webp)$"
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": ["src", "alt", "caption"]
      }
    }
  },
  "required": [
    "id",
    "topic",
    "preparedAt",
    "mode",
    "status",
    "stages",
    "keywords",
    "sources",
    "draft",
    "images"
  ]
}
