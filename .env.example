# Worker-side only. No frontend secret variables.
# Documentation only: this file is NOT loaded by the worker.
# Set values in the worker process environment or GitHub Actions secrets.
# Approve read_products on the installed app for catalog collection.
# SHOPIFY_ADMIN_ACCESS_TOKEN is a legacy fallback; no write access is required.
SITE_URL=https://ratniva.com
SHOPIFY_STORE_DOMAIN=
# Installed Dev Dashboard app in the same Shopify organization as the store.
# Preferred: exchange these credentials for a fresh in-memory token each audit.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional alternative: an existing access token, not the Client secret.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_READ_ACCESS_TOKEN=
GSC_SITE_URL=
GSC_CREDENTIALS_JSON=
PAGESPEED_API_KEY=
DRY_RUN=true
ENABLE_SHOPIFY_WRITES=false
PUBLISH_ENABLED=false
# Optional read-only sources; disabled to control crawl/API budgets.
ENABLE_PUBLIC_CRAWL=false
ENABLE_PAGESPEED=false
# Publishing requires protected environment setup, real approval, and dry-run verification.
PUBLISH_OPERATORS=
APPROVED_PROPOSAL_JSON=
ROLLBACK_ENCRYPTION_KEY=
# Optional encryption for detailed scheduled reports; never upload raw files.
PRIVATE_REPORT_ENCRYPTION_KEY=
MERCHANT_DIAGNOSTICS_PATH=
